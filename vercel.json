{
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/app/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"taskflex.apk\"" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
